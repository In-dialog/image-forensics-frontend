{
  "name": "image-forensics-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "build:local": "next build",
    "check:cloudflare": "node scripts/export-datasets.mjs --check",
    "build:cloudflare": "node scripts/export-datasets.mjs && next build cloudflare && node scripts/finalize-static-export.mjs",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "docs:capture": "node scripts/docs/capture.mjs",
    "docs:render": "node scripts/docs/render.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.118.0",
    "@react-three/fiber": "^9.0.0",
    "motion": "^12.34.3",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-photo-album": "^3.5.1",
    "three": "^0.170.0"
  },
  "overrides": {
    "three-mesh-bvh": "^0.8.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  }
}
