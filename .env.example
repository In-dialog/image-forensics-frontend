# Optional: the local backend. Saved results work without it.
ANALYSIS_API_URL=http://127.0.0.1:8766

# Optional: store newly imported datasets outside the bundled public database.
# ANALYSIS_DATA_DIR=/absolute/path/to/my-private-results

